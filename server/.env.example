# =============================================================================
# LandVision Server — Local Development Environment Example
# =============================================================================
# Copy this file to `server/.env` and fill in real values for local development.
#
#   cp server/.env.example server/.env
#
# In development (NODE_ENV unset or "development") missing variables only
# produce a console warning so the server can still boot for partial work.
# In production every variable is REQUIRED and the server refuses to boot.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
REDIS_URL=

# CORS: comma-separated list of allowed frontend origins.
# For local dev this is usually the Next.js dev server.
CLIENT_ORIGIN=http://localhost:3000

# NOTE: MongoDB is no longer used — all data lives in Supabase Postgres
# (or the local docker PostGIS for development).

# --- Supabase (Auth + Storage) ----------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- PostgreSQL / PostGIS ---------------------------------------------------
PG_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/landvision

# --- Gemini AI --------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# --- Validation tunables (optional) ----------------------------------------
CONFIDENCE_THRESHOLD=0.75
VILLAGE_AREA_LIMIT_HECTARES=500

# --- Auth / Dev Options ------------------------------------------------------
# Set to 'true' ONLY for local development if you want to bypass Supabase auth
# (injects a default dev user). MUST be false or unset in production.
ALLOW_DEV_AUTH_BYPASS=false

# --- Redis (optional for background jobs) -----------------------------------
REDIS_URL=
