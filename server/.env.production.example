# =============================================================================
# LandVision Server — Production Environment Example
# =============================================================================
# Copy this file to `server/.env.production` and fill in real values before
# deploying to Render (or set the same keys in the Render dashboard).
#
#   cp server/.env.production.example server/.env.production
#
# In production (NODE_ENV=production) EVERY variable listed below is REQUIRED.
# The server's startup check (server/src/config/env.ts) will throw a fatal
# error and refuse to boot if any of them are missing — a bad deploy fails
# loudly instead of silently running broken.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Render assigns PORT dynamically at runtime — do NOT hardcode a value here.
# The server reads process.env.PORT at boot.
PORT=4000
NODE_ENV=production

# CORS: comma-separated list of allowed frontend origins.
# Render backend will reject browser requests whose Origin is not in this list.
# Example: CLIENT_ORIGIN=https://landvision.vercel.app
# Example (multiple): https://landvision.vercel.app,https://landvision-preview.vercel.app
CLIENT_ORIGIN=https://your-frontend-url.vercel.app

# --- MongoDB Atlas (records / land records / review queue) -------------------
# Use a free M0 cluster on MongoDB Atlas for demo deployments.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/landvision?retryWrites=true&w=majority

# --- Supabase (Auth + Storage for the scanned document images) ---------------
# Use the same Supabase project that the frontend uses for auth.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key is REQUIRED on the backend to write to the private
# `land-records` storage bucket and to verify JWTs without rate limits.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- PostgreSQL / PostGIS (plot geometries, Sprint 4) ------------------------
# Render Postgres, Supabase Postgres, or any PostGIS-enabled DB works.
# SSL is automatically enabled when NODE_ENV=production (see config/db.ts).
PG_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST:5432/landvision?sslmode=require

# --- Gemini AI (multimodal extraction — Sprint 2) ----------------------------
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Validation tunables (optional in production — defaults shown) ----------
# Records with combined confidence below this go to `needs_review`.
CONFIDENCE_THRESHOLD=0.75
# Max total plot area per village in hectares. Triggers `exceeds_village_total`.
VILLAGE_AREA_LIMIT_HECTARES=500
