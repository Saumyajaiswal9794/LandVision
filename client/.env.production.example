# =============================================================================
# LandVision Client (Next.js) — Production Environment Example
# =============================================================================
# Copy this file to `client/.env.production` (or set the same keys in the
# Vercel project's Environment Variables settings — preferred).
#
#   cp client/.env.production.example client/.env.production
#
# IMPORTANT: variables prefixed with NEXT_PUBLIC_ are embedded into the
# client bundle at build time and are visible in the browser. NEVER put
# secrets here — only public API URLs / public Supabase keys.
# =============================================================================

# --- Backend API URL --------------------------------------------------------
# MUST point at the deployed Render backend, NOT localhost.
# Example: https://landvision-api.onrender.com
NEXT_PUBLIC_API_URL=https://your-render-backend-url.onrender.com

# --- Supabase (browser auth + storage public read key) ---------------------
# Use the SAME Supabase project as the backend so JWTs are mutually trusted.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
