# =============================================================================
# LandVision Client (Next.js) — Local Development Environment Example
# =============================================================================
# Copy this file to `client/.env.local` and fill in real values for local dev.
#
#   cp client/.env.example client/.env.local
#
# Variables prefixed with NEXT_PUBLIC_ are embedded into the client bundle at
# build time and are visible in the browser. NEVER put secrets here.
# =============================================================================

# --- Backend API URL --------------------------------------------------------
# For local development this is the Express server (default port 4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Supabase (browser auth + storage public read key) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
