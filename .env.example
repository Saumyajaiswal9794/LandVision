PG_CONNECTION_STRING=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Supabase Auth & Storage Config
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVER_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_STORAGE_BUCKET=land-records

# AWS S3 Config (Removed — using Supabase Storage instead)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=landvision-records

# AI & Extraction Services
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_VISION_API_KEY
LLM_API_KEY=YOUR_LLM_API_KEY

# Client Config
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_API_URL=http://localhost:5000

